# Server port (defaults to 5000 if unset)
PORT=5000

# Environment
NODE_ENV=development

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sufal_physics_forum

# Frontend origin(s) allowed for CORS. Add multiple comma-separated values if needed.
CLIENT_URL=http://localhost:5173

# JWT secrets - change these in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Google OAuth - required for Google Sign-In
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary - required for forum/homework/material image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
