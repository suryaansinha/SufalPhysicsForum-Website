# Server port (defaults to 5000 if unset)
PORT=5000

# Environment
NODE_ENV=development

# GoDaddy injects these at runtime when the hosted MySQL database is attached.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional Prisma CLI URL. Runtime PrismaClient uses the mysql2/mariadb pool from DB_* above.
# DATABASE_URL=mysql://user:password@host:3306/database

# Prisma cache directories. Set these as persistent GoDaddy/Airo runtime env vars
# (same dashboard section as DB_HOST), not only on the build command.
# Prefixing them on "build" does not apply them to the separate "start" process.
PRISMA_HOME=/tmp/prisma-home
XDG_CACHE_HOME=/tmp/prisma-cache

# Frontend origin(s) allowed for CORS. Add multiple comma-separated values if needed.
CLIENT_URL=http://localhost:5173

# JWT secrets - change these in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# JaaS meeting tokens. Set these in the deployment environment, never in source control.
# Base64-encode the complete RSA private-key PEM before setting JAAS_PRIVATE_KEY; do not commit the PEM.
# JAAS_APP_ID=vpaas-magic-cookie-b8f09e7827fb477c8fe12086fe39caea
# JAAS_KEY_ID=replace-with-console-key-id
# JAAS_PRIVATE_KEY=base64-encoded-rsa-private-key-pem

# Google OAuth - required for Google Sign-In
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary - required for forum/homework/material image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
