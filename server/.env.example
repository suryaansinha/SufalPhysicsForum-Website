# Server port (defaults to 5000 if unset)
PORT=5000

# Environment
NODE_ENV=development

# PostgreSQL connection string (legacy). Being replaced by GoDaddy MySQL.
# Local docker-compose default:
DATABASE_URL_V2=postgresql://postgres:postgres@localhost:5432/sufal_physics_forum

# Temporary TCP probe target for GoDaddy MySQL (host/port only; no password needed).
# Copy Hostname and Port from the GoDaddy Databases panel.
MYSQL_HOST=
MYSQL_PORT=3306

# Prisma cache directories. Set these as persistent GoDaddy/Airo runtime env vars
# (same dashboard section as DATABASE_URL_V2), not only on the build command.
# Prefixing them on "build" does not apply them to the separate "start" process.
PRISMA_HOME=/tmp/prisma-home
XDG_CACHE_HOME=/tmp/prisma-cache

# Frontend origin(s) allowed for CORS. Add multiple comma-separated values if needed.
CLIENT_URL=http://localhost:5173

# JWT secrets - change these in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Google OAuth - required for Google Sign-In
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary - required for forum/homework/material image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
